<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="hr_leave_view_form_sign_request_inherit" model="ir.ui.view">
        <field name="name">hr.leave.view.form.sign.request.inherit</field>
        <field name="model">hr.leave</field>
        <field name="inherit_id" ref="hr_holidays.hr_leave_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//group/field[@name='supported_attachment_ids']" position="after">
                <field name="sign_request_id" invisible="1" />
                <field name="sign_request_attachment_id" invisible="1" />
                <button
                    name="action_open_sign_request_wizard"
                    type="object"
                    string="Podpisz i załącz wniosek"
                    class="btn btn-secondary ms-2"
                    invisible="sign_request_attachment_id"
                />
            </xpath>
        </field>
    </record>
</odoo>
