<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <!-- FORM -->
    <record id="hr_leave_view_form_sign_request_inherit" model="ir.ui.view">
        <field name="name">hr.leave.view.form.sign.request.inherit</field>
        <field name="model">hr.leave</field>
        <field name="inherit_id" ref="hr_holidays.hr_leave_view_form"/>
        <field name="arch" type="xml">

            <xpath expr="//field[@name='supported_attachment_ids']" position="replace">
                <div class="o_row" invisible="not leave_type_support_document or state not in ('confirm', 'validate1')">
                    <field name="supported_attachment_ids" widget="many2many_binary" nolabel="1"/>
                    <field name="sign_request_id" invisible="1"/>
                    <field name="sign_request_attachment_id" invisible="1"/>

                    <span>
                        <button
                            name="action_open_sign_request_wizard"
                            type="object"
                            class="btn btn-secondary ms-2"
                            invisible="sign_request_attachment_id">
                            <span class="fa fa-pencil-square-o"/>
                            Podpisz i załącz wniosek
                        </button>
                    </span>
                </div>
            </xpath>

            <xpath expr="//field[@name='holiday_status_id']" position="after">
                <field name="is_planned"/>
            </xpath>

            <xpath expr="//field[@name='holiday_status_id']" position="attributes">
                <attribute name="readonly">state in ['cancel', 'refuse', 'validate', 'validate1'] or sign_request_attachment_id</attribute>
            </xpath>

            <xpath expr="//header" position="inside">
                <div class="badge text-bg-warning"
                     invisible="not is_planned">
                    Planned
                </div>
            </xpath>

            <xpath expr="//button[@name='action_approve']" position="attributes">
                <attribute name="invisible">is_planned</attribute>
            </xpath>

            <xpath expr="//button[@name='action_validate']" position="attributes">
                <attribute name="invisible">is_planned</attribute>
            </xpath>

        </field>
    </record>

    <!-- TREE -->
    <record id="hr_leave_view_tree_planned_inherit" model="ir.ui.view">
        <field name="name">hr.leave.view.tree.planned.inherit</field>
        <field name="model">hr.leave</field>
        <field name="inherit_id" ref="hr_holidays.hr_leave_view_tree"/>
        <field name="arch" type="xml">

            <xpath expr="//field[@name='state']" position="replace">
                <field name="display_state"/>
            </xpath>

        </field>
    </record>

    <!-- KANBAN -->
    <record id="hr_leave_view_kanban_planned_inherit" model="ir.ui.view">
        <field name="name">hr.leave.view.kanban.planned.inherit</field>
        <field name="model">hr.leave</field>
        <field name="inherit_id" ref="hr_holidays.hr_leave_view_kanban"/>
        <field name="arch" type="xml">

            <!-- make display_state available -->
            <xpath expr="//field[@name='supported_attachment_ids_count']"
                   position="after">
                <field name="display_state"/>
                <field name="is_planned"/>
            </xpath>

            <!-- replace displayed state -->
            <xpath expr="//field[@name='state']"
                   position="replace">
                <field name="display_state"/>
            </xpath>

        </field>
    </record>

</odoo>