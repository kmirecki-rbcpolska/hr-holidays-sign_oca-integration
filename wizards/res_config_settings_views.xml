<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="res_config_settings_view_form_hr_holidays_sign_integration" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.hr.holidays.sign.integration</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app
                    name="hr_holidays_sign_oca_integration"
                    string="Time Off"
                    data-string="Time Off"
                    groups="hr_holidays.group_hr_holidays_manager"
                >
                    <block id="hr_holidays_sign_notifications" title="Signed Time Off Documents">
                        <setting help="Additional email addresses that should receive the final signed time off document after the manager signs it.">
                            <field
                                name="time_off_signed_document_notification_emails"
                                placeholder="manager@example.com, hr@example.com"
                            />
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>